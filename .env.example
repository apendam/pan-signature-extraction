# Copy to .env (and keep it out of version control) or export these in your shell.

# GCP project that owns the Document AI processor.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Region the processor was created in: "us" or "eu" for most processor types.
DOCAI_LOCATION=us

# Processor ID (not the display name) of an OCR / Form Parser processor,
# e.g. projects/123/locations/us/processors/THIS_PART
DOCAI_PROCESSOR_ID=your-processor-id

# Auth is via Application Default Credentials, not a variable read by this
# app directly. Either:
#   gcloud auth application-default login
# or point at a service-account key:
#   GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
